load("//toolchain:tools.bzl", "tools")

package(default_visibility = ["//visibility:public"])

exports_files([
    "assemble.sh",
    "guard.sh",
    "linker.sh",
    "unsupported.sh",
])

filegroup(
    name = "linker_adapter",
    srcs = ["linker.sh"],
)

filegroup(
    name = "linker_rewrite",
    srcs = ["linker_args.awk"],
)

tools(
    name = "linux_x86_64",
    compiler = "@filc_exec_x86_64//:compiler",
)

tools(
    name = "linux_aarch64",
    compiler = "@filc_exec_aarch64//:compiler",
)
