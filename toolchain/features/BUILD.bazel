load("@rules_cc//cc/toolchains:feature.bzl", "cc_feature")
load("@rules_cc//cc/toolchains:feature_constraint.bzl", "cc_feature_constraint")
load("@rules_cc//cc/toolchains:feature_set.bzl", "cc_feature_set")

package(default_visibility = ["//visibility:public"])

cc_feature(
    name = "dynamic_linking_mode",
    overrides = "@rules_cc//cc/toolchains/features:dynamic_linking_mode",
)

cc_feature_constraint(
    name = "static_linking_mode",
    none_of = ["dynamic_linking_mode"],
)

# Keep runtime selection with Fil-C's target arguments: -static alone would
# leave the dynamic runtime active when rules_cc selects dynamic linking mode.
cc_feature(
    name = "fully_static_link",
    args = ["//toolchain/args:fully_static_shared_link_guard"],
    overrides = "@rules_cc//cc/toolchains/features/legacy:fully_static_link",
)

cc_feature_constraint(
    name = "dynamic_executable",
    all_of = ["dynamic_linking_mode"],
    none_of = ["fully_static_link"],
)

cc_feature(
    name = "no_legacy",
    feature_name = "no_legacy_features",
)

cc_feature(
    name = "default_compile_flags",
    overrides = "@rules_cc//cc/toolchains/features/legacy:default_compile_flags",
)

cc_feature(
    name = "opt_stub",
    overrides = "@rules_cc//cc/toolchains/features:opt",
)

cc_feature(
    name = "opt",
    args = [
        "//toolchain/args:opt_compile_flags",
        "//toolchain/args:opt_preprocess_assembly_flags",
        "//toolchain/args:opt_link_flags",
    ],
    feature_name = "_filc_opt",
    requires_any_of = ["opt_stub"],
)

cc_feature(
    name = "dbg_stub",
    overrides = "@rules_cc//cc/toolchains/features:dbg",
)

cc_feature(
    name = "dbg",
    args = [
        "//toolchain/args:dbg_compile_flags",
        "//toolchain/args:dbg_preprocess_assembly_flags",
        "//toolchain/args:assembly_debug_flags",
    ],
    feature_name = "_filc_dbg",
    requires_any_of = ["dbg_stub"],
)

cc_feature(
    name = "fastbuild_stub",
    overrides = "@rules_cc//cc/toolchains/features:fastbuild",
)

cc_feature(
    name = "fastbuild",
    args = [
        "//toolchain/args:fastbuild_compile_flags",
    ],
    feature_name = "_filc_fastbuild",
    requires_any_of = ["fastbuild_stub"],
)

