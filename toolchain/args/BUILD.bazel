# These source defaults follow the common GNU-driver policy. SaRCAsm has a
# separate assembly protocol; native-code frame/stack/section options do not
# describe its generated code and must not be inferred from these C/C++ flags.
cc_args(
    name = "default_compile_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile",
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
    ],
    args = [
        "-fstack-protector",
        "-Wall",
        "-Wthread-safety",
        "-Wself-assign",
        "-Wunused-but-set-parameter",
        "-Wno-free-nonheap-object",
        "-fcolor-diagnostics",
        "-fno-omit-frame-pointer",
    ],
    requires_any_of = ["//toolchain/features:default_compile_flags"],
)

cc_args(
    name = "default_cxx_compile_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
    ],
    args = ["-std=c++17"],
    requires_any_of = ["//toolchain/features:default_compile_flags"],
)

cc_args(
    name = "deterministic_compile_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile",
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
        "@rules_cc//cc/toolchains/actions:preprocess_assemble",
    ],
    args = [
        "-Wno-builtin-macro-redefined",
        "-D__DATE__=\"redacted\"",
        "-D__TIMESTAMP__=\"redacted\"",
        "-D__TIME__=\"redacted\"",
        "-ffile-compilation-dir=.",
    ],
)

cc_args(
    name = "opt_link_flags",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_link_executable",
        "@rules_cc//cc/toolchains/actions:cpp_link_dynamic_library",
        "@rules_cc//cc/toolchains/actions:cpp_link_nodeps_dynamic_library",
    ],
    args = [
        "-Wl,--gc-sections",
        "-Wl,--icf=safe",
    ],
)

cc_args(
    name = "pie_policy",
    # PIE constrains executable linkage, not object or shared-library creation.
    actions = ["@rules_cc//cc/toolchains/actions:cpp_link_executable"],
    env = select({
        "@llvm//constraints/pie:off": {"FILC_UNSUPPORTED_PIE": "off"},
        "//conditions:default": {},
    }),
)

cc_args(
    name = "fully_static_shared_link_guard",
    # Fil-C converts -static to static PIE even alongside -shared, combining
    # incompatible executable/DSO modes. Ordinary DSOs may still contain .a
    # dependencies; only the fully_static_link request on this action is invalid.
    # https://github.com/pizlonator/fil-c/blob/e7947f079c976fb167108f7407c20240bca0ca89/clang/lib/Driver/ToolChains/Gnu.cpp#L346-L359
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_link_dynamic_library",
        "@rules_cc//cc/toolchains/actions:cpp_link_nodeps_dynamic_library",
    ],
    env = {"FILC_UNSUPPORTED_LINKAGE": "fully_static_shared_link"},
)

cc_args(
    name = "c_header_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile",
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
        "@rules_cc//cc/toolchains/actions:assemble",
        "@rules_cc//cc/toolchains/actions:preprocess_assemble",
    ],
    allowlist_include_directories = [
        "//target:c_headers",
        "//target:stdfil_headers",
        "//target:kernel_headers",
    ],
    args = [
        "--filc-include={headers}",
        "--filc-stdfil-include={stdfil}",
        "--filc-os-include={os_headers}",
    ],
    data = [
        "//target:c_headers",
        "//target:kernel_headers",
        "//target:stdfil_headers",
    ],
    format = {
        "headers": "//target:c_headers",
        "stdfil": "//target:stdfil_headers",
        "os_headers": "//target:kernel_headers",
    },
)

cc_args(
    name = "cxx_header_search_paths",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile",
        "@rules_cc//cc/toolchains/actions:linkstamp_compile",
    ],
    allowlist_include_directories = [
        "//target:cxx_headers",
        "//target:cxx_config_headers",
    ],
    args = [
        "-nostdinc++",
        "-isystem",
        "{headers}",
        "-isystem",
        "{config}",
    ],
    data = [
        "//target:cxx_config_headers",
        "//target:cxx_headers",
    ],
    format = {
        "headers": "//target:cxx_headers",
        "config": "//target:cxx_config_headers",
    },
)

cc_args(
    name = "static_startfiles_and_libs",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_link_executable",
    ],
    args = [
        "-static",
        "--filc-crt-path={runtime}",
    ],
    data = ["//target:runtime"],
    env = {
        "FILC_TARGET_RUNTIME": "{runtime}",
    },
    format = {
        "runtime": "//target:runtime",
    },
    # rules_cc still owns dependency artifact selection. A selected DSO must
    # fail at the static link; this feature does not replace it with an archive.
    requires_any_of = [
        "@toolchains_filc//toolchain/features:static_linking_mode",
        "@toolchains_filc//toolchain/features:fully_static_link",
    ],
)

cc_args(
    name = "dynamic_startfiles_and_libs",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_link_executable",
    ],
    args = select({
        "@platforms//cpu:x86_64": [
            "--filc-crt-path={runtime}",
            "--filc-dynamic-linker=/lib/ld-fil1-x86_64.so",
            "--ld-path={adapter}",
        ],
        "@platforms//cpu:aarch64": [
            "--filc-crt-path={runtime}",
            "--filc-dynamic-linker=/lib/ld-fil1-aarch64.so",
            "--ld-path={adapter}",
        ],
    }),
    data = ["//target:dynamic_runtime"],
    env = {
        "FILC_TARGET_RUNTIME": "{runtime}",
    },
    format = {
        "runtime": "//target:dynamic_runtime",
        "adapter": "@toolchains_filc//toolchain/tools:linker_adapter",
    },
    # linkstatic controls application dependencies. Optfil lacks a static
    # native runtime closure, so both dependency modes use dynamic libc.
    requires_any_of = select({
        "@llvm//constraints/libc:musl": ["@toolchains_filc//toolchain/features:dynamic_executable"],
        "@llvm//constraints/libc:gnu.2.44": [],
    }),
)

cc_args(
    name = "shared_startfiles_and_libs",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_link_dynamic_library",
        "@rules_cc//cc/toolchains/actions:cpp_link_nodeps_dynamic_library",
    ],
    args = [
        "--filc-crt-path={runtime}",
        "--ld-path={adapter}",
    ],
    data = ["//target:dynamic_runtime"],
    env = {
        "FILC_TARGET_RUNTIME": "{runtime}",
    },
    format = {
        "runtime": "//target:dynamic_runtime",
        "adapter": "@toolchains_filc//toolchain/tools:linker_adapter",
    },
)
