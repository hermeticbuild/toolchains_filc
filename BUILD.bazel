load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "NOTICE",
])

constraint_setting(name = "application_abi")

selects.config_setting_group(
    name = "supported_libc",
    match_any = [
        "@llvm//platforms/config:musl",
        "glibc_2_44",
    ],
)

config_setting(
    name = "glibc_2_44",
    constraint_values = ["@llvm//constraints/libc:gnu.2.44"],
)

platform(
    name = "linux_x86_64_gnu.2.44",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.44",
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "abi",
    ],
)

platform(
    name = "linux_aarch64_gnu.2.44",
    constraint_values = [
        "@llvm//constraints/libc:gnu.2.44",
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "abi",
    ],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "abi",
    ],
)

constraint_value(
    name = "abi",
    constraint_setting = "application_abi",
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@llvm//constraints/libc:musl",
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "abi",
    ],
)

toolchain_type(name = "runtime_toolchain_type")

toolchain_type(name = "test_toolchain_type")
